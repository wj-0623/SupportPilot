{
  "title": "SupportPilot V4 Operations",
  "uid": "supportpilot-v3",
  "schemaVersion": 39,
  "refresh": "30s",
  "panels": [
    {"id": 1, "type": "timeseries", "title": "API requests", "targets": [{"expr": "sum(rate(supportpilot_http_requests_total[5m])) by (status)"}], "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}},
    {"id": 2, "type": "timeseries", "title": "P95 latency", "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(supportpilot_http_request_duration_seconds_bucket[5m])))"}], "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}},
    {"id": 3, "type": "timeseries", "title": "Action outcomes", "targets": [{"expr": "sum(rate(supportpilot_action_executions_total[5m])) by (action, status)"}], "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}},
    {"id": 4, "type": "timeseries", "title": "Grounded retrieval", "targets": [{"expr": "sum(rate(supportpilot_knowledge_retrievals_total[5m])) by (grounded)"}], "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}}
  ]
}
