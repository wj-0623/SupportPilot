ACTION_MAX_ATTEMPTS=3
MAX_AGENT_STEPS=4
EXPOSE_DEBUG_TRACE=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=shopsage-support-agent
CONNECTOR_TIMEOUT_SECONDS=10
CONNECTOR_MAX_RETRIES=2
WEBHOOK_TOLERANCE_SECONDS=300
