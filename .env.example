APP_ENV=development
AUTH_MODE=development
APP_API_KEY=
ADMIN_API_KEY=
JWT_SECRET=
JWT_JWKS_URL=
JWT_ISSUER=shopsage
JWT_AUDIENCE=shopsage-api
DEFAULT_TENANT_ID=tenant-demo
DEFAULT_TENANT_SLUG=demo-store
DEFAULT_DOMAIN_PACK=general-commerce
DATABASE_URL=sqlite+aiosqlite:///./data/support.db
REDIS_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
LLM_ENABLED=true
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
RATE_LIMIT_PER_MINUTE=60
