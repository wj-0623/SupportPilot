APP_ENV=production
AUTH_MODE=jwt
ENFORCE_TENANT_MEMBERSHIP=true
ENABLE_API_DOCS=false
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_JWKS_URL=https://identity.example.com/.well-known/jwks.json
JWT_ISSUER=https://identity.example.com/
JWT_AUDIENCE=supportpilot-api
APP_API_KEY=
ADMIN_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
LLM_ENABLED=true
MAX_REQUEST_BODY_BYTES=2000000
ACTION_MAX_ATTEMPTS=3
ACTION_LEASE_SECONDS=300
OUTBOUND_MAX_ATTEMPTS=5
OUTBOUND_LEASE_SECONDS=120
WORKER_METRICS_PORT=9100
CORS_ORIGINS=https://support.example.com
PUBLIC_DOMAIN=support.example.com
POSTGRES_PASSWORD=
REDIS_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
ALERT_WEBHOOK_URL_FILE=./secrets/alert_webhook_url
# Production policy: use immutable image@sha256 digests from the approved registry.
SUPPORTPILOT_IMAGE=registry.example.com/supportpilot@sha256:REPLACE
POSTGRES_IMAGE=postgres@sha256:REPLACE
REDIS_IMAGE=redis@sha256:REPLACE
CADDY_IMAGE=caddy@sha256:REPLACE
OTEL_IMAGE=otel/opentelemetry-collector-contrib@sha256:REPLACE
PROMETHEUS_IMAGE=prom/prometheus@sha256:REPLACE
GRAFANA_IMAGE=grafana/grafana@sha256:REPLACE
TEMPO_IMAGE=grafana/tempo@sha256:REPLACE
ALERTMANAGER_IMAGE=prom/alertmanager@sha256:REPLACE
